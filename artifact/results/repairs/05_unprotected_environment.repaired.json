{
  "case": {
    "expected_safe": false,
    "name": "unprotected_environment",
    "policy": {
      "Statement": [
        {
          "Action": "sts:AssumeRoleWithWebIdentity",
          "Condition": {
            "StringEquals": {
              "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
              "token.actions.githubusercontent.com:sub": "repo:acme/api:environment:prod"
            }
          },
          "Effect": "Allow",
          "Principal": {
            "Federated": "arn:aws:iam::000000000000:oidc-provider/token.actions.githubusercontent.com"
          }
        }
      ],
      "Version": "2012-10-17"
    },
    "repository_governance": {
      "protected_branches": [
        "main"
      ],
      "protected_environments": [
        {
          "environment": "prod",
          "owner": "acme",
          "repository": "api"
        }
      ]
    },
    "spec": {
      "allowed_audiences": [
        "sts.amazonaws.com"
      ],
      "allowed_subjects": [
        "repo:acme/api:environment:prod"
      ]
    }
  },
  "repair": {
    "audience_count": 1,
    "environment_governance_added": [
      {
        "environment": "prod",
        "owner": "acme",
        "repository": "api"
      }
    ],
    "environment_governance_required": [
      "acme/api:prod"
    ],
    "kind": "intent-exact-repair",
    "policy_language": "finite intent basis",
    "subject_count": 1
  }
}