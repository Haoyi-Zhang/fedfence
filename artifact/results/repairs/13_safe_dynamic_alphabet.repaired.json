{
  "case": {
    "expected_safe": true,
    "name": "safe_dynamic_alphabet",
    "policy": {
      "Statement": [
        {
          "Action": "sts:AssumeRoleWithWebIdentity",
          "Condition": {
            "StringEquals": {
              "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
              "token.actions.githubusercontent.com:sub": "repo:acme/api:ref:refs/heads/release$prod"
            }
          },
          "Effect": "Allow",
          "Principal": {
            "Federated": "arn:aws:iam::000000000000:oidc-provider/token.actions.githubusercontent.com"
          }
        }
      ],
      "Version": "2012-10-17"
    },
    "repository_governance": {
      "protected_branches": [
        "release$prod"
      ],
      "protected_environments": []
    },
    "spec": {
      "allowed_audiences": [
        "sts.amazonaws.com"
      ],
      "allowed_subjects": [
        "repo:acme/api:ref:refs/heads/release$prod"
      ]
    }
  },
  "repair": {
    "audience_count": 1,
    "environment_governance_added": [],
    "environment_governance_required": [],
    "kind": "intent-exact-repair",
    "policy_language": "finite intent basis",
    "subject_count": 1
  }
}