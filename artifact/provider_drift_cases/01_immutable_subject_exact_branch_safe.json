{
  "description": "GitHub immutable subject format with owner/repository IDs: exact main branch is contained in intent.",
  "expected_safe": true,
  "name": "immutable_subject_exact_branch_safe",
  "policy": {
    "Statement": [
      {
        "Action": "sts:AssumeRoleWithWebIdentity",
        "Condition": {
          "StringEquals": {
            "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
            "token.actions.githubusercontent.com:sub": "repo:acme@100/api@200:ref:refs/heads/main"
          }
        },
        "Effect": "Allow",
        "Principal": {
          "Federated": "arn:aws:iam::000000000000:oidc-provider/token.actions.githubusercontent.com"
        }
      }
    ],
    "Version": "2012-10-17"
  },
  "public_source": "GitHub Docs OpenID Connect reference, accessed Jun. 12, 2026",
  "repository_governance": {
    "protected_environments": []
  },
  "source_basis": "GitHub OIDC reference: immutable subject claims for repositories created after July 15, 2026.",
  "source_url": "https://docs.github.com/en/actions/reference/security/oidc",
  "spec": {
    "allowed_audiences": [
      "sts.amazonaws.com"
    ],
    "allowed_subjects": [
      "repo:acme@100/api@200:ref:refs/heads/main"
    ]
  }
}
