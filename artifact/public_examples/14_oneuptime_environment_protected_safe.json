{
  "name": "oneuptime_environment_protected_safe",
  "public_source": "Public environment-specific trust example with governance premise",
  "source_url": "https://oneuptime.com/blog/post/2026-01-25-github-actions-oidc-aws/view",
  "expected_safe": true,
  "policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "Federated": "arn:aws:iam::000000000000:oidc-provider/token.actions.githubusercontent.com"
        },
        "Action": "sts:AssumeRoleWithWebIdentity",
        "Condition": {
          "StringEquals": {
            "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
            "token.actions.githubusercontent.com:sub": "repo:your-org/your-repo:environment:production"
          }
        }
      }
    ]
  },
  "repository_governance": {
    "protected_environments": [
      {
        "owner": "your-org",
        "repository": "your-repo",
        "environment": "production"
      }
    ]
  },
  "spec": {
    "allowed_subjects": [
      "repo:your-org/your-repo:environment:production"
    ],
    "allowed_audiences": [
      "sts.amazonaws.com"
    ]
  }
}
