{
  "expected_safe": false,
  "name": "non_github_oidc_principal",
  "policy": {
    "Statement": [
      {
        "Action": "sts:AssumeRoleWithWebIdentity",
        "Condition": {
          "StringEquals": {
            "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
            "token.actions.githubusercontent.com:sub": "repo:acme/api:ref:refs/heads/main"
          }
        },
        "Effect": "Allow",
        "Principal": {
          "Federated": "arn:aws:iam::000000000000:oidc-provider/issuer.example.invalid"
        }
      }
    ],
    "Version": "2012-10-17"
  },
  "repository_governance": {
    "protected_branches": [
      "main"
    ],
    "protected_environments": []
  },
  "spec": {
    "allowed_audiences": [
      "sts.amazonaws.com"
    ],
    "allowed_subjects": [
      "repo:acme/api:ref:refs/heads/main"
    ]
  }
}
