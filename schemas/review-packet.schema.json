{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fedfence/review-packet.schema.json",
  "title": "FedFence review packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract", "snapshots"],
  "properties": {
    "schema": {"const": "fedfence-review-packet-v1"},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "repository", "target_role", "intent", "author", "max_snapshot_age_seconds", "review"],
      "properties": {
        "schema": {"const": "fedfence-intent-v1"},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "target_role": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "max_snapshot_age_seconds": {"type": "integer", "minimum": 1, "maximum": 2678400},
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["branches", "tags", "pull_request", "environments", "audiences"],
          "properties": {
            "branches": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "pull_request": {"type": "boolean"},
            "environments": {"type": "array", "items": {"$ref": "#/$defs/environment"}},
            "audiences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "review": {
          "type": "object",
          "required": ["basis", "reviewer", "reference", "approved_digest"],
          "properties": {
            "basis": {"const": "owner-supplied-specification"},
            "reviewer": {"type": "string", "minLength": 1},
            "reference": {"type": "string", "minLength": 1},
            "approved_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "required_tokens": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/requiredToken"}}
      }
    },
    "snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "issuer", "workflow", "governance"],
      "properties": {
        "policy": {"$ref": "#/$defs/snapshot"},
        "issuer": {"$ref": "#/$defs/snapshot"},
        "workflow": {"$ref": "#/$defs/snapshot"},
        "governance": {"$ref": "#/$defs/snapshot"}
      }
    }
  },
  "$defs": {
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "allowed_refs"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "allowed_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^refs/(heads|tags)/"}}
      }
    },
    "requiredToken": {
      "type": "object", "additionalProperties": false,
      "required": ["sub", "aud", "reason"],
      "properties": {
        "sub": {"type": "string", "minLength": 1},
        "aud": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "snapshot": {
      "type": "object",
      "required": ["body", "sha256", "source", "observed_at"],
      "properties": {
        "body": {"type": "object"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "target_role": {"type": "string"}
      }
    }
  }
}
